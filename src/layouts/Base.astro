---
import '@fontsource/im-fell-english/400.css';
import '@fontsource/im-fell-english/400-italic.css';
import '@fontsource-variable/literata';
import '@fontsource-variable/caveat';
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title?: string;
}

const { title = site.title } = Astro.props;
// Absolute once `site` is set in astro.config.mjs (when the domain exists).
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#f3ecdc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="A pressed sword fern specimen on cream paper" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <slot />
    </div>
    <script is:inline>
      // Tap the fern to show its note on touch screens.
      document.querySelectorAll('.fern').forEach((b) =>
        b.addEventListener('click', () => b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'))),
      );
      // Fade notes and sheets in once as they scroll into view.
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -10% 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

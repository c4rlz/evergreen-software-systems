---
import { site } from '../content/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p>© {year} {site.name} by {site.studio} · Vancouver Island, BC</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--evergreen-deep);
    color: var(--fog);
    font-size: 0.9rem;
    padding-block: 1.5rem;
  }
  .footer p {
    margin: 0;
  }
</style>

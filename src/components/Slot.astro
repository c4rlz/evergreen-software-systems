---
// A drawing or photo slot. Shows the image once its file exists in public/,
// and a dashed, labelled placeholder box until then (never a broken image).
import type { Image } from '../content/site';

// Every file under public/drawings and public/photos, known at build time.
const available = new Set(
  Object.keys(import.meta.glob('/public/{drawings,photos}/**/*')).map((path) => path.replace(/^\/public/, '')),
);

interface Props {
  image: Image;
  class?: string;
}

const { image, class: className } = Astro.props;
// Carly's own file wins; then the hand-drawn sketch; then the placeholder box.
const shown = available.has(image.src)
  ? { src: image.src, alt: image.alt, sketch: false }
  : image.sketch && available.has(image.sketch.src)
    ? { ...image.sketch, sketch: true }
    : null;
---

{
  shown ? (
    <img
      class:list={['slot-img', { 'slot-sketch': shown.sketch }, className]}
      src={shown.src}
      alt={shown.alt}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class:list={['slot', className]} role="img" aria-label={`Placeholder: ${image.placeholder}`}>
      <span class="hand">{image.placeholder}</span>
    </div>
  )
}

<style>
  .slot {
    display: grid;
    place-items: center;
    min-height: 6rem;
    padding: 0.75rem;
    border: 1.5px dashed var(--fern-soft);
    border-radius: 3px;
    text-align: center;
  }
  .slot .hand {
    font-size: 1.15rem;
    color: var(--fern-soft);
  }
  .slot-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Sketches are line drawings: show all of them, never crop. */
  .slot-sketch {
    object-fit: contain;
  }
</style>

---
// A dichotomous key, the "if this, go here" index real field guides use.
import { key, specimens } from '../content/site';
import Section from './Section.astro';

// Name each destination after its plate, or "Say hello" for the contact section.
const destination = (target: string) => specimens.find((s) => s.id === target)?.plate ?? 'Say hello';
---

<Section id="key" numeral="i." title="Key to the specimens">
  <ol class="key">
    {
      key.map((line) => (
        <li>
          <span class="couplet">{line.couplet}</span>
          <span class="text">{line.text}</span>
          <span class="dots" aria-hidden="true" />
          <a href={line.href}>{destination(line.target)}</a>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .key {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 1.1rem 1.25rem;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .couplet {
    flex: none;
    min-width: 2.2em;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-soft);
  }
  .text {
    min-width: 0;
  }
  .dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted var(--ink-soft);
    transform: translateY(-0.3rem);
  }
  a {
    flex: none;
    font-family: var(--font-display);
  }
  @media (max-width: 520px) {
    li {
      flex-wrap: wrap;
    }
    .text {
      flex: 1;
    }
    .dots {
      display: none;
    }
    a {
      flex-basis: 100%;
      padding-left: 2.8em;
    }
  }
</style>
